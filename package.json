{
  "name": "dotohub",
  "private": true,
  "version": "1.0.0",
  "description": "DotoHub — plateforme web professionnels DOTO+",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "deploy:surge": "npm run build && node -e \"require('fs').copyFileSync('dist/index.html','dist/200.html')\" && npx --yes surge ./dist doto-hub.surge.sh"
  },
  "dependencies": {
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
